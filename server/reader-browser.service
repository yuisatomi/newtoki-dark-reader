[Unit]
Description=Reader dedicated Chromium for manual site verification
After=network-online.target reader-proxy.service
Wants=network-online.target reader-proxy.service

[Service]
User=reader-sync
Group=reader-sync
Environment=HOME=/var/lib/reader-sync
Environment=XDG_CACHE_HOME=/var/lib/reader-sync/cache
StateDirectory=reader-sync
UMask=0077
ExecStart=/usr/bin/xvfb-run -a --server-args="-screen 0 1280x900x24 -nolisten tcp" /usr/bin/chromium --user-data-dir=/var/lib/reader-sync/browser-profile --remote-debugging-address=127.0.0.1 --remote-debugging-port=9222 --proxy-server=http://127.0.0.1:8081 --disable-dev-shm-usage --no-first-run --no-default-browser-check about:blank
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
MemoryMax=850M
MemorySwapMax=384M
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
